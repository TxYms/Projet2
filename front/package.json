{
  "name": "etudiant-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "e2e:build": "ng build --configuration e2e && nyc instrument dist/e2e-build/browser dist/e2e --complete-copy --source-map --delete --include \"dist/e2e-build/**\" --exclude-after-remap=false",
    "e2e:serve": "node scripts/serve-e2e.js",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "e2e": "npm run e2e:build && start-server-and-test e2e:serve http://localhost:4300 cypress:run"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.7",
    "@angular/cli": "^19.2.16",
    "@angular/compiler-cli": "^19.2.0",
    "@cypress/code-coverage": "^3.14.7",
    "@types/jest": "^29.5.4",
    "cypress": "^14.5.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.5.1",
    "nyc": "^15.1.0",
    "start-server-and-test": "^2.1.5",
    "typescript": "~5.7.2"
  }
}
